<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Name of a font family to use for body text. -->
    <string name="config_bodyFontFamily" translatable="false">google-sans-flex</string>

    <!-- Name of a font family to use for medium body text. -->
    <string name="config_bodyFontFamilyMedium" translatable="false">google-sans-flex-medium</string>

    <!-- Name of the font family to use in the default lockscreen clock -->
    <string name="config_clockFontFamily" translatable="false">google-sans-flex-clock</string>

    <!-- Name of a font family to use for headlines. If empty, falls back to platform default -->
    <string name="config_headlineFontFamily" translatable="false">google-sans-flex</string>

    <string name="config_headlineFontFamilyMedium" translatable="false">google-sans-flex-medium</string>
    <!-- Allows setting custom fontFeatureSettings on specific text. -->
    <string name="config_headlineFontFeatureSettings" translatable="false">ss03</string>
    <!-- Name of a font family to use as light font. For theming purpose. -->
    <string name="config_lightFontFamily" translatable="false">@string/config_bodyFontFamily</string>
    <!-- Name of a font family to use as regular font. For theming purpose. -->
    <string name="config_regularFontFamily" translatable="false">@string/config_bodyFontFamily</string>

</resources>
